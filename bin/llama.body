# llama —— 本地大模型（官方 WebUI + 内置文件工具）
set -uo pipefail
ROOT="${LLAMA_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
WORK="${LLAMA_WORK:-$HOME/Desktop/llama-workspace}"
PORT="${PORT:-8082}"
export LLAMA_TOOLS="${LLAMA_TOOLS:-read_file,file_glob_search,grep_search,exec_shell_command,write_file,edit_file}"
export LLAMA_MCP_PROXY="${LLAMA_MCP_PROXY:-0}"  # 没接 MCP server，关掉省一条侧栏
export REASONING="${REASONING:-off}"            # off / auto：auto 才有"思考力度"开关
say(){ printf '\033[36m▸\033[0m %s\n' "$*"; }
up(){ curl -s -o /dev/null -m 2 "http://127.0.0.1:8093/health"; }

start() {
  mkdir -p "$WORK"
  if up; then say "已在运行：http://127.0.0.1:8093"; else
    say "启动中（模型加载约 5 秒，工作目录 $WORK）"
    ( cd "$WORK" && "$ROOT/core/server.sh" start --pick ) || return 1
    pgrep -f "core/compact_proxy.py" >/dev/null || ( nohup python3 -u "$ROOT/core/compact_proxy.py" >>"$ROOT/var/proxy.log" 2>&1 & )
    sleep 1
    for _ in $(seq 1 60); do up && break; sleep 1; done
    up || { echo "起不来，看：$0 logs"; return 1; }
  fi
  command -v xdg-open >/dev/null && xdg-open "http://127.0.0.1:8093" >/dev/null 2>&1 &
  say "网页：http://127.0.0.1:8093   文件操作：已开（能改 $WORK 里的东西）"
  autostart_qq
}

autostart_qq() {
  [ -f "$ROOT/bridge/qq_bridge.py" ] || return 0
  if ! ss -ltn 'sport = :8090' 2>/dev/null | grep -q 8090; then
    ( cd "$ROOT/bridge" && setsid nohup python3 qq_bridge.py >>"$ROOT/var/bridge.log" 2>&1 & )
    sleep 1
  fi
  if ! ss -ltn 'sport = :3000' 2>/dev/null | grep -q 3000 && [ -d "$ROOT/bridge/qqbot/node_modules" ]; then
    ( cd "$ROOT/bridge/qqbot" && setsid nohup node sidecar.mjs >>"$ROOT/var/sidecar.log" 2>&1 & )
    sleep 1
  fi
  if ss -ltn 'sport = :8090' 2>/dev/null | grep -q 8090; then
    say "QQ 桥：已起（面板 http://127.0.0.1:8091 ，第一次打开会显示二维码）"
  else
    say "QQ 桥没起来，看 $ROOT/var/bridge.log"
  fi
}

stopall() {
  "$ROOT/core/server.sh" stop
  for p in 8090 8091 3000; do
    local pid=$(ss -ltnp "sport = :$p" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
  done
  say "模型、桥、sidecar 都已停止"
}

roleplay() {
  local p="$ROOT/var/persona.txt"
  "$ROOT/bin/pick-persona" "$p" || return 0
  [ -f "$p" ] || return 0
  say "已保存。打开网页后点右上角齿轮 → System prompt，粘贴下面这段："
  echo "----------------------------------------"
  cat "$p"
  echo "----------------------------------------"
  command -v xclip >/dev/null && xclip -selection clipboard <"$p" && say "（已复制到剪贴板）"
  start
}

qq() {
  local b="$ROOT/bridge/qq_bridge.py"
  [ -f "$b" ] || { echo "没找到 $b"; return 1; }
  if ss -ltn 'sport = :8090' 2>/dev/null | grep -q 8090; then
    say "QQ 桥已在运行：http://127.0.0.1:8090（NapCat 上报地址填这个）"
  else
    ( cd "$ROOT/bridge" && setsid nohup python3 qq_bridge.py >"$ROOT/var/bridge.log" 2>&1 & )
    sleep 2
    ss -ltn 'sport = :8090' 2>/dev/null | grep -q 8090 && say "QQ 桥已启动：0.0.0.0:8090 → llama :8082" || { echo "起不来，看 $ROOT/var/bridge.log"; return 1; }
  fi
  printf '配置：%s\n白名单和人设、世界书都在 %s/data/\n' "$ROOT/bridge/config.json" "$ROOT/bridge"
}

THINKF="$ROOT/var/think"
ask_think() {
  local d=off; [ -f "$THINKF" ] && d=$(cat "$THINKF")
  local hint=0; [ "$d" = on ] && hint=1
  printf '思考模式？1 开 / 0 关（默认 %s）：' "$hint"
  local v; read -r v || v=""
  [ -z "$v" ] && v=$hint
  case "$v" in
    1|y|Y|on) export REASONING=auto; echo on >"$THINKF"; say "思考：开（速度约 1/3，但复杂推理更稳）" ;;
    *) export REASONING=off; echo off >"$THINKF"; say "思考：关（快）" ;;
  esac
}

conn_menu() {
  local cf="$ROOT/bridge/config.json"
  while :; do
    printf '\n\033[1m连接设置\033[0m\n'
    python3 - "$cf" <<'PYEOF'
import json,sys
c=json.load(open(sys.argv[1]))
print(f"  监听端口 {c.get('port',8090)}   模型 {c.get('model','')}")
print(f"  白名单  {c.get('whitelist',[])}")
PYEOF
    printf '  1) 显示二维码   2) 加白名单   3) 删白名单\n  4) 重启桥   5) 看桥日志   0) 返回\n'
    printf '选择: '; read -r k || return 0
    case "$k" in
      1) python3 - "$ROOT/bridge/qqbot/qr.txt" <<'PYEOF'
import sys,os
p=sys.argv[1]
if not os.path.exists(p): print("还没有二维码，先跑一次 QQ 机器人"); sys.exit()
try: import qrcode
except Exception: print("缺 qrcode 库（python3 -m pip install qrcode）"); sys.exit()
qr=qrcode.QRCode(border=1); qr.add_data(open(p).read().strip()); qr.make()
qr.print_ascii(invert=True)
PYEOF
         ;;
      2) printf '要加的 QQ 号/openid: '; read -r w || continue
         [ -z "$w" ] && continue
         python3 - "$cf" "$w" <<'PYEOF'
import json,sys
p,w=sys.argv[1],sys.argv[2]
c=json.load(open(p)); l=c.setdefault("whitelist",[])
if w not in l: l.append(w); json.dump(c,open(p,"w"),ensure_ascii=False,indent=2)
print("白名单：", l)
PYEOF
         ;;
      3) printf '要删的: '; read -r w || continue
         python3 - "$cf" "$w" <<'PYEOF'
import json,sys
p,w=sys.argv[1],sys.argv[2]
c=json.load(open(p)); c["whitelist"]=[x for x in c.get("whitelist",[]) if x!=w]
json.dump(c,open(p,"w"),ensure_ascii=False,indent=2); print("白名单：", c["whitelist"])
PYEOF
         ;;
      4) restart_bridge ;;
      5) tail -n 30 "$ROOT/var/bridge.log" 2>/dev/null || echo "还没有日志" ;;
      0) return 0 ;;
    esac
    printf '\n回车继续…'; read -r _
  done
}

role_menu() {
  local pf="$ROOT/bridge/data/personas.json" wf="$ROOT/bridge/data/worldbook.json" cf="$ROOT/bridge/config.json"
  while :; do
    printf '\n\033[1m角色 / 世界观\033[0m\n'
    python3 - "$pf" "$wf" "$cf" <<'PYEOF'
import json,sys
P=json.load(open(sys.argv[1])); W=json.load(open(sys.argv[2])); C=json.load(open(sys.argv[3]))
print("  人设：" + "、".join(P) + f"   默认：{C.get('default_persona','-')}")
for i,w in enumerate(W,1):
    print(f"  {i}) {'●' if w.get('enabled') else '○'} {w.get('name','?')}  [关键词 {w.get('keyword','')}]")
PYEOF
    printf '  1) 切换默认人设   2) 开关世界观   0) 返回\n选择: '; read -r k || return 0
    case "$k" in
      1) "$ROOT/bin/pick-persona" "$ROOT/var/persona.txt" || continue
         python3 - "$ROOT/var/persona.txt" "$cf" <<'PYEOF'
import json,sys,os
p,cf=sys.argv[1],sys.argv[2]
name=open(p).read().splitlines()[0].strip() if os.path.exists(p) else ""
c=json.load(open(cf))
print("提示：默认人设仍在 config.json 里，改这里只影响本机 roleplay 用的 persona.txt")
PYEOF
         ;;
      2) printf '编号: '; read -r n || continue
         python3 - "$wf" "$n" <<'PYEOF'
import json,sys
p,n=sys.argv[1],sys.argv[2]
w=json.load(open(p))
try: i=int(n)-1; w[i]['enabled']=not w[i].get('enabled')
except Exception: print("编号不对"); sys.exit(1)
json.dump(w,open(p,'w'),ensure_ascii=False,indent=2)
print(f"{w[i].get('name')} → {'开' if w[i]['enabled'] else '关'}")
PYEOF
         ;;
      0) return 0 ;;
    esac
    printf '\n回车继续…'; read -r _
  done
}

restart_bridge() {
  local pid
  pid=$(ss -ltnp 'sport = :8090' 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
  [ -n "$pid" ] && kill "$pid" 2>/dev/null && sleep 1
  ( cd "$ROOT/bridge" && setsid nohup python3 qq_bridge.py >>"$ROOT/var/bridge.log" 2>&1 </dev/null & )
  sleep 2
  ss -ltn 'sport = :8090' | grep -q 8090 && say "桥已重启" || say "桥没起来，看 var/bridge.log"
}

menu() {
  while :; do
    printf '\n\033[1m本地大模型\033[0m  工作目录 %s\n' "$WORK"
    printf '  1) 启动    打开网页（角色/世界书/空间/日志/QQ 都在网页里管）\n'
    printf '  2) 停止\n  3) 状态\n  4) 帮助\n  q) 退出\n'
    printf '选择 [1]: '; read -r c || exit 0
    case "${c:-1}" in
      1) ask_think; start ;;
      2) stopall ;;
      3) "$ROOT/core/server.sh" status ;;
      4) sed -n '2,8p' "$0" | sed 's/^# //' ;;
      6) role_menu ;;
      q|Q) exit 0 ;;
